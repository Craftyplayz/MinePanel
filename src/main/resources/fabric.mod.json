{
  "schemaVersion": 1,
  "id": "minepanel",
  "version": "${version}",
  "name": "MinePanel",
  "description": "A client-side Minecraft companion dashboard served locally.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.craftyplayz.minepanel.MinePanelClient"
    ]
  },
  "mixins": [
    {
      "config": "minepanel.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.154.0"
  }
}
