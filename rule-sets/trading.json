{
  "format": "minepanel-rules",
  "version": 1,
  "profiles": [
    {
      "id": "trading-panel",
      "name": "Trading Panel",
      "panels": {
        "villagers": { "x": 0, "y": 0,  "w": 8, "h": 12, "mode": "rules" },
        "player":    { "x": 8, "y": 0,  "w": 4, "h": 4 },
        "pickups":   { "x": 8, "y": 4,  "w": 4, "h": 10 },
        "inventory": { "x": 0, "y": 12, "w": 4, "h": 6 },
        "history":   { "x": 4, "y": 12, "w": 4, "h": 6 },
        "xp":        { "x": 8, "y": 14, "w": 4, "h": 4 }
      },
      "settings": {
        "xp": { "window": 300 }
      }
    }
  ],
  "rules": [
    {
      "id": "trading-hall",
      "name": "Trading hall",
      "when": [
        { "type": "villagersNearby", "radius": 10, "compare": ">=", "value": 5 }
      ],
      "then": [
        { "do": "profile", "profile": "trading-panel" },
        { "do": "show", "panel": "villagers" }
      ],
      "timing": { "delayMs": 3000, "lingerMs": 20000 }
    }
  ]
}
